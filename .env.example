# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── PureChain node ────────────────────────────────────────────
# For local Hardhat simulation during development:
PURECHAIN_RPC_URL=http://127.0.0.1:8545
PURECHAIN_CHAIN_ID=31337
PURECHAIN_PRIVATE_KEY=your_private_key_here

# For real PureChain node (final experiments):
# PURECHAIN_RPC_URL=http://127.0.0.1:8546
# PURECHAIN_CHAIN_ID=12345
# PURECHAIN_PRIVATE_KEY=your_purechain_validator_key

# ── Deployed contract addresses (filled after deploy) ─────────
SUPPLY_EVENT_LOGGER_ADDRESS=
DECISION_AUDIT_ADDRESS=

# ── LLM settings ──────────────────────────────────────────────
# primary: gpt-4o   secondary: llama3:70b
LLM_PRIMARY=gpt-4o
LLM_SECONDARY=llama3:70b
OLLAMA_BASE_URL=http://localhost:11434

# ── ChromaDB ──────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db

# ── Experiment settings ───────────────────────────────────────
CORRUPTION_RATE=0.15
K_ASSET=5
K_ROUTING=3
BOOTSTRAP_SAMPLES=1000
