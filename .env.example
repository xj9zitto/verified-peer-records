# ── PureChain (public values; read-only verification needs nothing else) ──
PURECHAIN_RPC_URL=https://purechainnode.com
PURECHAIN_CHAIN_ID=900520900520
SUPPLY_EVENT_LOGGER_ADDRESS=0xB96F110c14be274B2F2e52EC658cc97A3Fd3aEA3
# Pinned authorised writer (the contract owner); checked against every receipt.
PURECHAIN_ANCHOR_ADDRESS=0x32a394ef2565657C27f76Ed0EdE9EEE084955476
# Optional extra endpoints for the unanimity rule (comma-separated).
PURECHAIN_QUORUM_URLS=
# Only needed to WRITE events (re-anchoring); never committed to this repo.
PURECHAIN_PRIVATE_KEY=

# ── LLM settings (all reported runs: local Ollama, temperature 0) ──
LLM_PRIMARY=gemma3:4b
LLM_SECONDARY=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434

# ── ChromaDB (legacy four-action task only) ──
CHROMA_PERSIST_DIR=./data/chroma_db

# ── Experiment settings ──
CORRUPTION_RATE=0.15
K_ASSET=5
K_ROUTING=3
BOOTSTRAP_SAMPLES=1000
